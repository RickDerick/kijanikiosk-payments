{
  "name": "kijanikiosk-payments",
  "version": "1.0.0",
  "description": "KijaniKiosk payments service: validates payment requests and exposes a small HTTP API",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "node scripts/build.js",
    "start": "node src/server.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "30.5.2",
    "jest-junit": "^17.0.0"
  }
}
